# Copy to .env in this directory (infra/.env) and fill in real values.
# .env is gitignored — never commit it.

# --- Caddy / TLS ---
# Your DuckDNS (or other) domain. Caddy uses this for automatic HTTPS via Let's Encrypt.
DOMAIN=binsight.duckdns.org
# Email for Let's Encrypt expiry/renewal notices — not published anywhere, just Caddy -> Let's Encrypt.
ACME_EMAIL=you@example.com

# --- Backend (Fastify) ---
# Same-origin deployment (Caddy reverse-proxies /api/* to the backend on the same domain), so
# this mainly matters as defense in depth, not because the browser actually needs cross-origin CORS.
ALLOWED_ORIGIN=https://binsight.duckdns.org

# Hosted-mode Groq API key. Omit entirely to run BYOK-only (hosted mode disables itself without it).
GROQ_API_KEY=

# Defaults from backend/src/config/env.ts are fine for a low-traffic portfolio deployment;
# override only if you have a specific reason to.
# RATE_LIMIT_MAX=20
# RATE_LIMIT_WINDOW_MS=60000
# DAILY_QUOTA_MAX=200
